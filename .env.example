# Copy to .env. Never commit real credentials.
DISCORD_TOKEN=
GROQ_API_KEY=
# Optional primary provider. If empty, Groq is used directly.
TOKENME_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
# Optional: instant slash-command registration for one development guild.
DISCORD_ADDITIONAL_GUILD_IDS=
DISCORD_GUILD_ID=
DATABASE_PATH=data/bot.sqlite3
# Docker stores this filename inside its persistent /app/data volume.
DATABASE_FILENAME=bot.sqlite3
BOT_NAME=เพื่อนดิส
TIMEZONE=Asia/Bangkok
# Local conservative ceilings; check your own Groq limits before changing.
REQUESTS_PER_MINUTE=20
REQUESTS_PER_DAY=900
TOKENS_PER_MINUTE=7000
TOKENS_PER_DAY=180000
MAX_OUTPUT_TOKENS=768
MAX_CONTEXT_BYTES=3500
QUEUE_SIZE=20
WORKERS=1
USER_COOLDOWN_SECONDS=3
# 30 days of local chat history; explicit memories expire after 180 days.
# Cache fetched history for 30 days, including older messages retrieved on demand.
HISTORY_RETENTION_DAYS=30
AUTO_HISTORY_ENABLED=true
AUTO_HISTORY_MESSAGES=300
AUTO_HISTORY_CHANNELS=3
AUTO_HISTORY_TOTAL=600
AUTO_HISTORY_TIMEOUT=20
AUTO_HISTORY_CACHE_SECONDS=60
MEMORY_RETENTION_DAYS=180
MAX_MESSAGES_PER_GUILD=100000
# RAM-only conversation context, scoped by guild/channel/person/private flag; 0 disables.
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_TURNS=3
MEMORY_SUGGESTIONS=true
# 0 disables automatic backups. Files stay inside the persistent data volume.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
QUOTA_ALERT_PERCENT=80
LOG_LEVEL=INFO
# Public web tools: also enable each channel with /mcp channel.
TAVILY_API_KEY=
MCP_ENABLED=false
MCP_URL=http://127.0.0.1:8000/mcp
MCP_REQUESTS_PER_MINUTE=6
MCP_REQUESTS_PER_DAY=100
# 0 disables the optional per-person daily tool cap.
MCP_USER_REQUESTS_PER_DAY=0
# Mention/reply in unconfigured text rooms where Discord permits sending; no automatic history storage.
AUTO_RESPOND_ACCESSIBLE_CHANNELS=false
# Optional JSON list of 1–3 public RSS/Atom URLs; empty uses BBC Technology + Ars Technica.
RSS_FEEDS=

# Optional private Telegram integration; list numeric account IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Accounts allowed to view aggregate usage in Telegram.
TELEGRAM_USAGE_ADMIN_IDS=
