[Unit]
Description=Discord USB companion bot
After=network-online.target discord-usb-search.service
Requires=discord-usb-search.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=discord-companion-usb
StateDirectoryMode=0700
WorkingDirectory=/opt/discord-companion-usb
EnvironmentFile=/etc/discord-companion-usb.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DATABASE_PATH=/var/lib/discord-companion-usb/bot.sqlite3 MCP_ENABLED=true MCP_URL=http://127.0.0.1:8000/mcp
ExecStart=/opt/discord-companion-usb/venv/bin/python -m bot
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
